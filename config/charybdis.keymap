#include <behaviors.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/* DEFINICIONES DE HARDWARE */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500 // Sensibilidad del trackball
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20 // Velocidad scroll

// --- MANUAL INPUT DEFINITIONS (Safe for all forks) ---
// Definimos los códigos hexadecimales directos para evitar errores de headers faltantes
#define INPUT_EV_REL       0x02
#define INPUT_REL_WHEEL    0x08
#define INPUT_REL_HWHEEL   0x06

/* Definimos capas por nombre por claridad */
#define DVORAK 0
#define QWERTY 1
#define NAV 2
#define MOUSE 3
#define SYM 4
#define NUM 5
#define FUN 6

// --- SPANISH OS KEY DEFINITIONS (Mapeo HID para OS en Español) ---
// Símbolos estándar
#define ES_NTILDE   SEMICOLON        // Ñ (Tecla ; en US)
#define ES_ACUT     SINGLE_QUOTE     // Tilde ´ (Tecla ' en US)
#define ES_PLUS     RIGHT_BRACKET    // + (Tecla ] en US)
#define ES_ASTR     LS(RIGHT_BRACKET)// *
#define ES_LBRC     RA(LEFT_BRACKET) // [
#define ES_RBRC     RA(RIGHT_BRACKET)// ]
#define ES_LCBR     RA(SINGLE_QUOTE) // { (AltGr + ' en ES)
#define ES_RCBR     RA(BACKSLASH)    // } (AltGr + Ç en ES)
#define ES_LPAR     LS(N8)           // (
#define ES_RPAR     LS(N9)           // )
#define ES_EQUAL    LS(N0)           // =
#define ES_MINUS    SLASH            // - (Tecla / en US)
#define ES_UNDER    LS(SLASH)        // _
#define ES_SLASH    LS(N7)           // /
#define ES_BSLH     RA(GRAVE)        // \ (AltGr + º)
#define ES_PIPE     RA(N1)           // |
#define ES_AT       RA(N2)           // @
#define ES_HASH     RA(N3)           // #
#define ES_DLLR     LS(N4)           // $
#define ES_PRCNT    LS(N5)           // %
#define ES_AMPS     LS(N6)           // &
#define ES_LESS     NUBS      // < (Tecla ISO al lado de Z)
#define ES_GRTR     LS(NUBS)  // >
#define ES_QUOT     LS(N2)           // "
#define ES_SQUOT    MINUS            // ' (Comilla simple en tecla - US)
#define ES_QMARK    LS(MINUS)        // ?
#define ES_EXCL     LS(N1)           // !
#define ES_DOT      DOT              // .
#define ES_COMMA    COMMA            // ,
#define ES_COLON    LS(DOT)          // :
#define ES_SCLN     LS(COMMA)        // ;
#define ES_TILD     RA(N4)           // ~
#define ES_CIRC     LS(LEFT_BRACKET) // ^ (Shift + ` en ES)
#define ES_GRV      LEFT_BRACKET     // ` (Tecla ` en ES, que es [ en US)

&lt {
    quick-tap-ms = <200>;
};

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE>;
};

/ {

    /* DEFINICIÓN MANUAL DE PROCESADORES DE INPUT 
     * Esto soluciona el error "undefined node label 'zip_xy_scaler'"
     */
    
    // 1. Escalador: Permite multiplicar/dividir la señal del trackball (para sensibilidad)
    zip_xy_scaler: zip_xy_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
    };

    // 2. Transformador: Convierte movimiento XY en Scroll Vertical/Horizontal
    zip_scroll_mapper: zip_scroll_mapper {
        compatible = "zmk,input-processor-transform";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_HWHEEL>; // Movimiento X -> Scroll Horizontal
        y-codes = <INPUT_REL_WHEEL>;  // Movimiento Y -> Scroll Vertical
    };

    /* COMBOS */
    combos {
        compatible = "zmk,combos";

        // Brackets {} -> Dvoral C+R
        combo_lbrc {
            timeout-ms = <40>;
            key-positions = <19 20>; 
            bindings = <&kp ES_LCBR>; // {
            layers = <DVORAK>;
        };
        combo_rbrc {
            timeout-ms = <40>;
            key-positions = <20 21>;
            bindings = <&kp ES_RCBR>; // }
            layers = <DVORAK>;
        };

        // Parentheses () -> Dvoral U+E
        combo_lpar {
            timeout-ms = <40>;
            key-positions = <14 15>; 
            bindings = <&kp ES_LPAR>;
            layers = <DVORAK>;
        };
        combo_rpar {
            timeout-ms = <40>;
            key-positions = <15 16>; 
            bindings = <&kp ES_RPAR>;
            layers = <DVORAK>;
        };

        // Arrow =>
        combo_arrow {
            timeout-ms = <40>;
            key-positions = <16 19>;
            bindings = <&macro_arrow_func>;
            layers = <DVORAK>;
        };

        // Debug Salesforce
        combo_debug {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&macro_sys_debug>;
            layers = <DVORAK>;
        };
    };

    /* MACROS */
    macros {
        macro_arrow_func: macro_arrow_func {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ES_EQUAL &kp ES_GRTR &kp SPACE>;
        };

        macro_thin_arrow: macro_thin_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ES_MINUS &kp ES_GRTR>;
        };

        macro_sys_debug: macro_sys_debug {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp Y &kp S &kp T &kp E &kp M &kp ES_DOT &kp D &kp E &kp B &kp U &kp G &kp ES_LPAR &kp ES_RPAR &kp ES_SCLN &kp LEFT &kp LEFT>;
        };

        swapper: swapper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT>;
        };
    };

    /* BEHAVIORS */
    behaviors {
        /* HOMEROW MODS */
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred"; 
            bindings = <&kp>, <&kp>;
        };

        // Tap Dance: ; (1 tap) vs : (2 taps)
        td_scln: tap_dance_semicolon {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SEMICOLON";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ES_SCLN>, <&kp ES_COLON>;
        };

        tb_scroll: trackball_scroll_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "TB_SCROLL";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&tog>;
        };

        // COMPORTAMIENTO DEL TRACKBALL: CURSOR
        // MOVIMIENTO ESTANDAR 1:1
        /*tmv_coarse: trackball_move_coarse {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            binding = <&mmv>;
            input-processors = <&zip_xy_scaler 1 1>; // Escala natural
        };*/

        // COMPORTAMIENTO DEL TRACKBALL: SCROLL (Trackpad-like)
        // Usamos un divisor (1/24 por ejemplo) para que el movimiento sea fluido.
        // Si el divisor es muy bajo (1/10), el scroll vuela.
        // Si es alto (1/40), es muy preciso pero lento.
        // zip_scroll_transform convierte movimiento XY a Scroll.
        tmv_scroll: trackball_scroll_fine {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            binding = <&msc>;
            input-processors = <&zip_xy_scaler 1 24>, <&zip_xy_to_scroll_mapper>;
        };
    };

    /* KEYMAP */
    keymap {
        compatible = "zmk,keymap";

        // ------------------------------------------------------------------------------------------------------
        // LAYER 0: DVORAK (Dvorak on Spanish OS)
        // Notas:
        // - ES_SQUOT es '
        // - ES_COMMA es ,
        // - ES_DOT es .
        // - ES_SCLN es ;
        // - ES_NTILDE es Ñ (Añadido en lugar de BSLH)
        // ------------------------------------------------------------------------------------------------------
        DVORAK {
            label = "DVORAK";
            bindings = <
    &kp ESC    &kp N1      &kp N2      &kp N3       &kp N4       &kp N5               &kp N6       &kp N7       &kp N8       &kp N9      &kp N0          &kp ES_NTILDE
    &kp TAB    &kp ES_MINUS &kp ES_COMMA &kp ES_DOT &kp P        &kp Y                &kp F        &kp G        &kp C        &kp R       &kp L           &kp ES_SLASH
    &caps_word &hm LGUI A  &hm LALT O  &hm LCTRL E  &hm LSHIFT U &kp I                &kp D        &hm RSHIFT H &hm RCTRL T  &hm RALT N  &hm RGUI S      &kp ES_ACUT
    &kp LSHFT  &td_scln       &kp Q       &kp J        &kp K        &kp X                &kp B        &kp M        &kp W        &kp V       &kp Z           &kp RSHFT
    
                            // CLUSTER IZQUIERDO                        // CLUSTER DERECHO
                            &mkp LCLK   &mkp RCLK     &tb_scroll MOUSE MOUSE    &lt SYM SPACE   &mo NUM
                                        &lt NAV SPACE &kp BSPC                  &lt FUN ENTER 
            >;
            trackball-bindings = <&tmv_coarse>; 
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 1: QWERTY
        // ------------------------------------------------------------------------------------------------------
        QWERTY {
            bindings = <
    &kp ESC         &kp N1          &kp N2  &kp N3          &kp N4     &kp N5      &kp N6          &kp N7          &kp N8          &kp N9            &to 0                   &kp BACKSPACE
    &kp TAB         &kp Q           &kp W   &DOBLE_TECLA_E  &kp R      &kp T       &kp Y           &DOBLE_TECLA_U  &DOBLE_TECLA_I  &DOBLE_TECLA_O    &kp P                   &kp BSLH
    &kt LEFT_SHIFT  &DOBLE_TECLA_A  &kp S   &kp D           &kp F      &kp G       &kp H           &kp J           &kp K           &kp L             &DOBLE_TECLA_SEMICOLON  &kp SQT
    &kp LEFT_GUI    &kp Z           &kp X   &kp C           &kp V      &kp B       &DOBLE_TECLA_N  &kp M           &kp COMMA       &kp LEFT_BRACKET  &kp FSLH                &kp MINUS
                                        &kp LCTRL       &kp SPACE  &mo 3       &kp LALT        &kp GRAVE
                                                        &mkp MB1   &mkp MB2    &kp ENTER
            >;

            trackball-bindings = <&tmv_coarse>;
            label = "QWERTY";
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 2: NAV
        // ------------------------------------------------------------------------------------------------------
        nav_layer {
            label = "NAV";
            bindings = <
    &trans     &trans       &trans       &trans       &trans       &trans               &trans       &trans       &trans       &trans      &trans          &trans
    &swapper   &trans       &trans       &trans       &trans       &trans               &kp HOME     &kp PG_DN    &kp PG_UP    &kp END     &trans          &trans
    &trans     &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHIFT   &trans               &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT   &trans          &trans
    &trans     &kp LC(Z)    &kp LC(X)    &kp LC(C)    &kp LC(V)    &kp LC(Y)            &trans       &trans       &trans       &trans      &trans          &trans
    
                            &trans       &trans       &trans               &trans       &trans
                                         &trans       &kp DEL              &trans
            >;
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 3: MOUSE (Scroll)
        // ------------------------------------------------------------------------------------------------------
        mouse_layer {
            label = "MOUSE";
            bindings = <
    &trans     &trans       &trans       &trans       &trans       &trans               &trans       &trans       &trans       &trans      &trans          &trans
    &trans     &trans       &trans       &trans       &trans       &trans               &trans       &trans       &trans       &trans      &trans          &trans
    &trans     &trans       &trans       &trans       &trans       &trans               &trans       &trans       &trans       &trans      &trans          &trans
    &trans     &trans       &trans       &trans       &trans       &trans               &trans       &trans       &trans       &trans      &trans          &trans
    
                            &mkp LCLK    &mkp RCLK    &trans               &trans       &trans
                                         &trans       &trans               &trans
            >;
            trackball-bindings = <&tmv_scroll>;
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 4: SYM
        // Estructura:
        // Left:  Lógica y Sigils (! @ # $ % / Logic)
        // Right: Sintaxis y Estructura ( () {} [] <> Math )
        // ------------------------------------------------------------------------------------------------------
        sym_layer {
            label = "SYM";
            bindings = <
    &trans     &trans       &trans       &trans       &trans       &trans               &trans       &trans       &trans       &trans      &trans          &trans
    &trans     &kp ES_EXCL  &kp ES_AT    &kp ES_HASH  &kp ES_DLLR  &kp ES_PRCNT         &kp ES_LESS  &kp ES_GRTR  &kp ES_LBRC  &kp ES_RBRC &kp ES_UNDER    &trans
    &trans     &kp ES_BSLH  &kp ES_PIPE  &kp ES_AMPS  &macro_thin_arrow &macro_arrow_func &kp ES_LPAR  &kp ES_RPAR  &kp ES_LCBR  &kp ES_RCBR &kp ES_EQUAL    &trans
    &trans     &kp ES_TILD  &kp ES_CIRC  &kp ES_GRV   &kp ES_SQUOT &trans               &kp ES_PLUS  &kp ES_MINUS &kp ES_ASTR  &kp ES_SLASH &kp ES_QUOT    &trans
    
                            &trans       &trans       &trans               &trans       &trans
                                         &trans       &trans               &trans
            >;
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 6: FUN
        // ------------------------------------------------------------------------------------------------------
        fun_layer {
            label = "FUN";
            bindings = <
    &bootloader &trans      &trans       &trans       &trans       &trans               &trans       &trans       &trans       &trans      &trans          &bootloader
    &trans     &kp F12      &kp F7       &kp F8       &kp F9       &trans               &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR   &trans
    &trans     &kp F11      &kp F4       &kp F5       &kp F6       &trans               &trans       &trans       &trans       &trans      &trans          &trans
    &trans     &kp F10      &kp F1       &kp F2       &kp F3       &trans               &trans       &trans       &trans       &trans      &trans          &trans
    
                            &trans       &trans       &trans               &trans       &trans
                                         &trans       &trans               &trans
            >;
        };
    };
};